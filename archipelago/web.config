<?xml version="1.0" encoding="utf-8"?>
<!--
  Archipelago — IIS site root = this folder (HttpPlatformHandler + next start)

  Public: https://archipelago.ae

  Prerequisites:
    - IIS HttpPlatformHandler installed
    - Node.js at C:\Program Files\nodejs\node.exe
    - npm run build completed (.next present)
    - logs\ folder exists for stdout
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>

    <rewrite>
      <outboundRules>
        <rule name="FixNextLocalhostRedirect" preCondition="IsRedirect">
          <match serverVariable="RESPONSE_Location" pattern="^https?://(localhost|127\.0\.0\.1):\d+(.*)$" />
          <action type="Rewrite" value="https://archipelago.ae{R:2}" />
        </rule>
        <rule name="CacheNextStatic" preCondition="IsNextStatic">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <preConditions>
          <preCondition name="IsRedirect">
            <add input="{RESPONSE_STATUS}" pattern="3\d\d" />
          </preCondition>
          <preCondition name="IsNextStatic">
            <add input="{REQUEST_URI}" pattern="^/_next/static/" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <httpPlatform
      processPath="C:\Program Files\nodejs\node.exe"
      arguments=".\node_modules\next\dist\bin\next start -H 127.0.0.1 -p %HTTP_PLATFORM_PORT%"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\stdout.log"
      startupTimeLimit="60"
      startupRetryCount="3">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
